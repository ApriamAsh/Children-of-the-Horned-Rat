<form class="{{cssClass}} careerless-item-sheet" autocomplete="off">
  <header class="sheet-header compact">
    <img class="profile-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <input class="item-name" name="name" type="text" value="{{item.name}}" />
  </header>
  <section class="item-body">
    <div class="item-fields-grid">
      <label>Quantity<input name="system.quantity" type="number" min="0" value="{{system.quantity}}" /></label>
      <label>Weight (kg each)<input name="system.weight" type="number" min="0" step="0.1" value="{{system.weight}}" /></label>
      <label>Equipped<input name="system.equipped" type="checkbox" {{checked system.equipped}} /></label>
      <label>Armour Points<input name="system.armourPoints" type="number" min="0" value="{{system.armourPoints}}" /></label>
      <label>Armour Location
        <select name="system.location">
          <option value="head" {{#if (eq system.location "head")}}selected{{/if}}>Head</option>
          <option value="body" {{#if (eq system.location "body")}}selected{{/if}}>Body</option>
          <option value="rightArm" {{#if (eq system.location "rightArm")}}selected{{/if}}>Right Arm</option>
          <option value="leftArm" {{#if (eq system.location "leftArm")}}selected{{/if}}>Left Arm</option>
          <option value="rightLeg" {{#if (eq system.location "rightLeg")}}selected{{/if}}>Right Leg</option>
          <option value="leftLeg" {{#if (eq system.location "leftLeg")}}selected{{/if}}>Left Leg</option>
          <option value="all" {{#if (eq system.location "all")}}selected{{/if}}>All Locations</option>
        </select>
      </label>
      <label>Weapon Type<input name="system.weaponType" type="text" value="{{system.weaponType}}" placeholder="Melee, pistol, basic…" /></label>
      <label>Damage<input name="system.damage" type="text" value="{{system.damage}}" placeholder="e.g. 1d10+3 R" /></label>
      <label>Range<input name="system.range" type="text" value="{{system.range}}" placeholder="e.g. 30 m" /></label>
      <label>Talent Tier<input name="system.tier" type="number" min="1" max="5" value="{{system.tier}}" /></label>
      <label>Skill Characteristic<select name="system.skillCharacteristic"><option value="weaponSkill" {{#if (eq system.skillCharacteristic "weaponSkill")}}selected{{/if}}>Weapon Skill</option><option value="ballisticSkill" {{#if (eq system.skillCharacteristic "ballisticSkill")}}selected{{/if}}>Ballistic Skill</option><option value="strength" {{#if (eq system.skillCharacteristic "strength")}}selected{{/if}}>Strength</option><option value="toughness" {{#if (eq system.skillCharacteristic "toughness")}}selected{{/if}}>Toughness</option><option value="agility" {{#if (eq system.skillCharacteristic "agility")}}selected{{/if}}>Agility</option><option value="intelligence" {{#if (eq system.skillCharacteristic "intelligence")}}selected{{/if}}>Intelligence</option><option value="perception" {{#if (eq system.skillCharacteristic "perception")}}selected{{/if}}>Perception</option><option value="willpower" {{#if (eq system.skillCharacteristic "willpower")}}selected{{/if}}>Willpower</option><option value="fellowship" {{#if (eq system.skillCharacteristic "fellowship")}}selected{{/if}}>Fellowship</option></select></label>
      <label>Skill Modifier<input name="system.skillModifier" type="number" value="{{system.skillModifier}}" /></label>
      <label>Skill Advances<input name="system.skillAdvances" type="number" min="0" max="3" value="{{system.skillAdvances}}" /></label>
      <label>Power Type<input name="system.powerType" type="text" value="{{system.powerType}}" placeholder="Spell, Prayer, Psychic…" /></label>
      <label>Power Characteristic<select name="system.powerCharacteristic"><option value="willpower" {{#if (eq system.powerCharacteristic "willpower")}}selected{{/if}}>Willpower</option><option value="intelligence" {{#if (eq system.powerCharacteristic "intelligence")}}selected{{/if}}>Intelligence</option><option value="fellowship" {{#if (eq system.powerCharacteristic "fellowship")}}selected{{/if}}>Fellowship</option><option value="weaponSkill" {{#if (eq system.powerCharacteristic "weaponSkill")}}selected{{/if}}>Weapon Skill</option><option value="ballisticSkill" {{#if (eq system.powerCharacteristic "ballisticSkill")}}selected{{/if}}>Ballistic Skill</option><option value="strength" {{#if (eq system.powerCharacteristic "strength")}}selected{{/if}}>Strength</option><option value="toughness" {{#if (eq system.powerCharacteristic "toughness")}}selected{{/if}}>Toughness</option><option value="agility" {{#if (eq system.powerCharacteristic "agility")}}selected{{/if}}>Agility</option><option value="perception" {{#if (eq system.powerCharacteristic "perception")}}selected{{/if}}>Perception</option></select></label>
      <label>Power Modifier<input name="system.powerModifier" type="number" value="{{system.powerModifier}}" /></label>
      <label>Power Effect / Damage<input name="system.powerDamage" type="text" value="{{system.powerDamage}}" /></label>
      <label>XP Cost<input name="system.xpCost" type="number" min="0" value="{{system.xpCost}}" /></label>
      <label>Aptitude 1<input name="system.aptitude1" type="text" value="{{system.aptitude1}}" /></label>
      <label>Aptitude 2<input name="system.aptitude2" type="text" value="{{system.aptitude2}}" /></label>
    </div>
    <label>Description<textarea name="system.description">{{system.description}}</textarea></label>
  </section>
</form>
